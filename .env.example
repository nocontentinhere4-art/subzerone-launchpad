# SUBZERONE launchpad: environment template. No secrets here: generate your own values.
# A feature whose secret is missing is OFF and the UI says so.

# --- app -------------------------------------------------------------------------------------------------------------
DEPLOY_ENV=development               # production refuses the mock provider and needs https + APP_ENCRYPTION_KEY
PORT=8787
HOST=127.0.0.1                       # 0.0.0.0 behind a proxy / in a container
PUBLIC_ORIGIN=http://localhost:8787  # exact origin users load; writes from any other origin are refused
PROJECTS_HOST=projects.localhost:8787  # generated sites live on <slug>.<PROJECTS_HOST>; production: e.g. projects.subzerone.live
PROJECTS_SCHEME=http
TRUST_PROXY=0                        # 1 behind Railway/Cloudflare so rate limits see the client IP
DATA_DIR=data                        # SQLite database, uploads, backups
APP_ENCRYPTION_KEY=                  # 32 random bytes, base64: `openssl rand -base64 32`. Encrypts X tokens.
ADMIN_WALLETS=                       # comma-separated Solana addresses that are always admin
SUB01_FEE_WALLET=                    # SUB-01's wallet: the fixed 20% creator-fee row of EVERY project. Unset = nothing can be approved/launched (409 sub01_wallet_missing)
CITY_DIST=                           # optional, absolute path to the city client's Vite build (dist/). Set: city at /, launchpad home at /launchpad
SUB01_DATASETS=                      # GET /api/disclosure: comma list of the public MRI datasets SUB-01's brain model was derived from (max 20 × 80 chars). Unset = []
OPERATOR_NAME=                       # GET /api/disclosure: who operates SUB-01 (person or company, max 80 chars). Unset = null
SESSION_DAYS=7
AUTH_NONCE_TTL_S=300

# --- SUB-01 brain service (the live server's /api/launchpad/evaluate) -------------------------------------------------
BRAIN_URL=                           # e.g. https://subzerone.live (or http://127.0.0.1:8765 for the local demo brain)
LAUNCHPAD_BRAIN_SECRET=              # same value on both sides: `openssl rand -hex 32`
BRAIN_PUBLIC_URL=https://subzerone.live   # the live room shown on the home page
BRAIN_TIMEOUT_MS=20000

# --- generation -----------------------------------------------------------------------------------------------------
GENERATOR=template                   # template (no AI) | anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
GENERATOR_PRICE_IN_PER_MTOK=         # USD per million input tokens, from the provider's price page (budget accounting)
GENERATOR_PRICE_OUT_PER_MTOK=
# coin art (docs/COIN-ART.md): with no key the local black-and-white generator draws it (no AI)
HF_API_KEY_ID=                       # Higgsfield API key id and secret (cloud.higgsfield.ai / console.higgsfield.ai)
HF_API_KEY_SECRET=
# HF_API_KEY=<id>:<secret>           # or the two in one, as the console shows them
HF_LOGO_MODEL=recraft/v4.1/text-to-image
HF_BANNER_MODEL=recraft/v4.1/text-to-image
HF_PARAMS=                           # optional JSON merged into the Higgsfield body, e.g. {"model_type":"vector"} if the endpoint takes it
RECRAFT_API_KEY=                     # optional: Recraft's own API, used when no Higgsfield key is set
RECRAFT_MODEL=recraftv4_1_vector
ART_PROVIDER_BANNERS=0               # 1: ask the provider for the banners too; 0: compose them around the logo
ART_PRICE_USD_PER_IMAGE=0
ART_TIMEOUT_MS=45000
BUDGET_GLOBAL_DAILY_USD=5
BUDGET_PER_PROJECT_USD=1
MAX_ACTIVE_GENERATIONS=3
MAX_IDEAS_PER_WALLET_PER_DAY=3

# --- launch ---------------------------------------------------------------------------------------------------------
LAUNCH_PROVIDER=mock                 # mock (tests/local only) | pumpfun | none
SOLANA_NETWORK=devnet                # devnet | mainnet-beta
SOLANA_RPC_URL=https://api.devnet.solana.com
LAUNCH_LOOKUP_TABLE=                 # address lookup table for create + locked fee split + dev buy (npm run lookup-table; --extend <table> for one made before the dev buy)
LAUNCH_SPLIT_TX=1                    # 1: two-step launch (tx1 create_v2, tx2 the locked fee split, author-only); 0: the old single creation transaction
MAX_INITIAL_BUY_SOL=5                # cap of the author's optional dev buy in the creation transaction (the code never allows more than 5)
REQUIRE_ADMIN_CLEARANCE=1
SUB01_MARKET_RPC_URL=https://api.mainnet-beta.solana.com

# --- launched coins' stats (city building lights; coin-stats.js, GET /api/coins/:mint/stats) --------------------------
COIN_STATS=1                         # 0 turns the refresh job off (the city then sees tier 0 everywhere)
HELIUS_API_KEY=                      # holder counts via Helius DAS getTokenAccounts. Unset = holders null (never estimated)
HELIUS_URL=                          # alternative: a full https://mainnet.helius-rpc.com/?api-key=… URL (takes precedence)
HELIUS_DAILY_PAGES=1000              # DAS calls a day across all coins (1,000 accounts each, ≈ 10 credits per call); 20 per coin per fetch
DEXSCREENER_MIN_GAP_MS=2000          # one DexScreener call per this many ms across all coins (2000 = 30/min; the documented limit is 60/min)

# --- X (official OAuth 2.0 + PKCE) ------------------------------------------------------------------------------------
X_CLIENT_ID=
X_CLIENT_SECRET=                     # only for a confidential client
X_REDIRECT_URI=                      # https://<launchpad>/api/x/callback, registered in the X developer portal

# --- help / support (support.js; the city's Help button, /admin#support) --------------------------------------------
SUPPORT_OPERATOR_TOKEN=              # bearer token for the AI operator's inbox (GET /api/support/inbox, POST /api/support/:id/reply|status);
                                     # unset = those routes do not exist (404). 24+ printable characters: openssl rand -hex 32
TELEGRAM_BOT_TOKEN=                  # the owner's ping on every new report (category, first 200 chars, link). Both unset = no ping
TELEGRAM_CHAT_ID=                    # the chat the bot writes to (numeric id, or @channel)

# --- backups --------------------------------------------------------------------------------------------------------
BACKUP_EVERY_HOURS=24
BACKUP_KEEP=14

# Organization-scoped Anthropic keys (sk-ant-usr-...) need the workspace to use; workspace-scoped keys do not.
ANTHROPIC_WORKSPACE_ID=
